{
  "name": "unquotable-web",
  "version": "0.6.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo --hostname 0.0.0.0",
    "build": "node scripts/guard-build.js && next build",
    "build:unguarded": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "next": "^14.2.35",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "react-qr-code": "^2.0.15"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
