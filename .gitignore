# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/

# Environment variables — never commit real values; see .env.example for the
# variable names this app expects.
.env
.env*.local

# Vercel CLI link metadata (project/org IDs) — machine-local, regenerated by
# `vercel link`.
.vercel/

# Playwright's failure evidence — traces, screenshots, videos and the HTML
# report. Per-run and often large; the trace for the run you just did is the
# only one worth anything, and it is regenerated by re-running the layer.
test-results/
playwright-report/
blob-report/
.playwright/

# TypeScript incremental build caches — machine-local, regenerated on build.
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
npm-debug.log*

# OS cruft
.DS_Store
Thumbs.db

# Quotebook source data — real content, kept local and deliberately untracked.
quotebooks/
