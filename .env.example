# AES-256-GCM encryption key for game state values. REQUIRED in production -
# the app now refuses to start without it rather than silently falling back to
# the insecure development key that is committed to this repo.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAME_ENCRYPTION_KEY=

# Supabase Postgres connection string — use the "Transaction" pooler (Supavisor),
# not the direct connection: Dashboard → Project Settings → Database →
# Connection string → "Transaction" mode, port 6543. Required for serverless
# (Vercel functions open/close connections per invocation; the pooler handles
# that, a direct connection would exhaust Postgres's connection limit).
# Format: postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Before first use, run supabase/schema.sql and then supabase/cron.sql in the
# Supabase SQL Editor, in that order. schema.sql creates the required tables
# (game_states, rate_limits); cron.sql installs the hourly sweeps that enforce
# the 24-hour retention promised in the app's own privacy text. Both are
# required in production, and both are safely re-runnable. cron.sql refuses to
# run if schema.sql has not been applied yet.
SUPABASE_DB_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Running the tests: do NOT point them here, and do not add a .env.test either.
#
# The test suite takes its connection string from the PROCESS ENVIRONMENT of the
# command that runs it, and refuses to start against any host that is not a
# known test database. That is not belt-and-braces: `next start` forces
# NODE_ENV=production, so Next loads `.env.local` - this file's real
# counterpart, holding the production string above - and never reads `.env.test`,
# which it consults only when NODE_ENV is `test`. Only the process environment
# outranks `.env.local`, so it is the only place the test string can go.
#
#   docker exec -w /workspace/projects/bracketapp-web \
#     -e SUPABASE_DB_URL=postgres://uq:uq@test-db:5432/uq_test dev-env npm test
#
# See the README's Tests section.
