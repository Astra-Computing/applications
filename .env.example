# AES-256-GCM encryption key for game state files.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAME_ENCRYPTION_KEY=

# Directory where game state JSON files are written.
# In Railway: set this to the path of your mounted Volume (e.g. /data/game_states).
# Locally: leave unset to use the default ./game_states folder.
STATE_DIR=
