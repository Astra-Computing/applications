# AES-256-GCM encryption key for game state values.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAME_ENCRYPTION_KEY=

# Upstash Redis, provisioned via the Vercel Marketplace "Upstash for Redis"
# integration (Storage tab) or directly from the Upstash console.
# Vercel's integration may inject these as KV_REST_API_URL / KV_REST_API_TOKEN
# instead — src/lib/redis.ts accepts either naming.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
