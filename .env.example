# AES-256-GCM encryption key for game state values. REQUIRED in production -
# the app now refuses to start without it rather than silently falling back to
# the insecure development key that is committed to this repo.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAME_ENCRYPTION_KEY=

# Supabase Postgres connection string — use the "Transaction" pooler (Supavisor),
# not the direct connection: Dashboard → Project Settings → Database →
# Connection string → "Transaction" mode, port 6543. Required for serverless
# (Vercel functions open/close connections per invocation; the pooler handles
# that, a direct connection would exhaust Postgres's connection limit).
# Format: postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Before first use, run supabase/setup.sql in the Supabase SQL Editor to
# create the required tables (game_states, rate_limits) and cleanup cron jobs.
SUPABASE_DB_URL=
